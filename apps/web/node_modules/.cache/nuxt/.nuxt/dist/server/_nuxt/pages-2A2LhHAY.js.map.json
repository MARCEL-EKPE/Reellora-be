vue"],"sourcesContent":["<template>\r\n    <GoogleSignInButton\r\n    @success=\"ggLoginSuccess\"\r\n    @error=\"ggLoginError\"\r\n    size=\"large\"\r\n    width=\"240\"\r\n    text=\"continue_with\"\r\n    />\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useFetch , useNuxtApp } from \"#app\";\r\nimport { GoogleSignInButton, type CredentialResponse } from \"vue3-google-signin\";\r\n\r\nconst ggLoginSuccess = async (response: CredentialResponse) => {\r\n  const { credential } = response;\r\n  try {\r\n    await $fetch(\"http://localhost:3000/google-authentication\", {\r\n      method: \"POST\",\r\n      body: { token: credential },\r\n    });\r\n  } catch (err) {\r\n    console.error(\"Request failed:\", err);\r\n  }\r\n};\r\n\r\nconst ggLoginError = () => {\r\n  console.error(\"Login failed\");\r\n};\r\n</script>\r\n","<template>\r\n    <GoogleSignInButton\r\n    @success=\"ggLoginSuccess\"\r\n    @error=\"ggLoginError\"\r\n    size=\"large\"\r\n    width=\"240\"\r\n    text=\"continue_with\"\r\n    />\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useFetch , useNuxtApp } from \"#app\";\r\nimport { GoogleSignInButton, type CredentialResponse } from \"vue3-google-signin\";\r\n\r\nconst ggLoginSuccess = async (response: CredentialResponse) => {\r\n  const { credential } = response;\r\n  try {\r\n    await $fetch(\"http://localhost:3000/google-authentication\", {\r\n      method: \"POST\",\r\n      body: { token: credential },\r\n    });\r\n  } catch (err) {\r\n    console.error(\"Request failed:\", err);\r\n  }\r\n};\r\n\r\nconst ggLoginError = () => {\r\n  console.error(\"Login failed\");\r\n};\r\n</script>\r\n","<template>\r\n      <HFaceBookLogin \r\n        v-slot=\"fbLogin\" \r\n        app-id=\"1966803287385992\" \r\n        @onSuccess=\"fbLoginSuccess\" \r\n        @onFailure=\"fbLoginError\"\r\n        scope=\"email,public_profile\"\r\n        fields=\"id,name,email,name,picture\"\r\n      >\r\n        <button \r\n          @click=\"fbLogin.initFBLogin\"\r\n          class=\"flex items-center justify-center gap-3 px-5 py-2 rounded-[0.3rem] text-white font-medium transition-all duration-200 ease-in-out bg-[#1877f2] hover:bg-[#166fe5] focus:ring-2 focus:ring-[#1877f2]/50 active:scale-95 shadow-sm\"\r\n        >\r\n          <Icon name=\"mdi:facebook\" class=\"text-2xl\" />\r\n          <span class=\"text-sm\">Continue with Facebook</span>\r\n        </button>\r\n      </HFaceBookLogin>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useFetch } from \"#app\";\r\nimport FacebookLoginPkg from \"@healerlab/vue3-facebook-login\";\r\n\r\nconst { HFaceBookLogin } = FacebookLoginPkg as any;\r\n\r\n\r\nconst fbLoginSuccess = async (response: any) => {\r\n  const { accessToken } = response.authResponse;\r\n  // send token to your backend for verification\r\n  await useFetch(\"http://localhost:3000/facebook-authentication\", {\r\n    method: \"POST\",\r\n    body: {token: accessToken },\r\n  });\r\n};\r\n\r\nconst fbLoginError = (error: any) => {\r\n  console.error(\"Facebook login failed\", error);\r\n};\r\n</script>\r\n<!-- https://www.termsfeed.com/live/53ee2405-06e3-4d2e-a434-01aab4831efd -->\r\n","<template>\r\n      <HFaceBookLogin \r\n        v-slot=\"fbLogin\" \r\n        app-id=\"1966803287385992\" \r\n        @onSuccess=\"fbLoginSuccess\" \r\n        @onFailure=\"fbLoginError\"\r\n        scope=\"email,public_profile\"\r\n        fields=\"id,name,email,name,picture\"\r\n      >\r\n        <button \r\n          @click=\"fbLogin.initFBLogin\"\r\n          class=\"flex items-center justify-center gap-3 px-5 py-2 rounded-[0.3rem] text-white font-medium transition-all duration-200 ease-in-out bg-[#1877f2] hover:bg-[#166fe5] focus:ring-2 focus:ring-[#1877f2]/50 active:scale-95 shadow-sm\"\r\n        >\r\n          <Icon name=\"mdi:facebook\" class=\"text-2xl\" />\r\n          <span class=\"text-sm\">Continue with Facebook</span>\r\n        </button>\r\n      </HFaceBookLogin>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useFetch } from \"#app\";\r\nimport FacebookLoginPkg from \"@healerlab/vue3-facebook-login\";\r\n\r\nconst { HFaceBookLogin } = FacebookLoginPkg as any;\r\n\r\n\r\nconst fbLoginSuccess = async (response: any) => {\r\n  const { accessToken } = response.authResponse;\r\n  // send token to your backend for verification\r\n  await useFetch(\"http://localhost:3000/facebook-authentication\", {\r\n    method: \"POST\",\r\n    body: {token: accessToken },\r\n  });\r\n};\r\n\r\nconst fbLoginError = (error: any) => {\r\n  console.error(\"Facebook login failed\", error);\r\n};\r\n</script>\r\n<!-- https://www.termsfeed.com/live/53ee2405-06e3-4d2e-a434-01aab4831efd -->\r\n","<template>\r\n  <button\r\n  @click=\"linkYoutube\"\r\n    class=\"group flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-red-600 font-semibold border border-red-300 shadow-sm hover:bg-red-600 hover:text-white transition-all duration-300 focus:ring-4 focus:ring-red-300\"\r\n  >\r\n    <Icon\r\n      name=\"mdi:youtube\"\r\n      size=\"25\"\r\n      class=\"transition-transform duration-300 group-hover:scale-110\"\r\n    />\r\n    <span class=\"tracking-wide\">Link YouTube</span>\r\n  </button>\r\n</template>\r\n\r\n<!-- <template>\r\n  <button\r\n   @click=\"linkYoutube\"\r\n    class=\"flex items-center gap-2 px-5 py-2.5 rounded-full bg-red-600 text-white font-medium shadow-sm hover:bg-red-700 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-red-400\"\r\n  >\r\n    <Icon name=\"mdi:youtube\" size=\"20\" />\r\n    Link YouTube\r\n  </button>\r\n</template> -->\r\n\r\n\r\n<script setup lang=\"ts\">\r\nconst linkYoutube = async () => {\r\n  try {\r\n    const res = await fetch('http://localhost:3000/social-accounts/youtube/link');\r\n\r\n    if (!res.ok) {\r\n      throw new Error(`HTTP error! status: ${res.status}`);\r\n    }\r\n\r\n    const parseResponse = await res.json();\r\n\r\n    window.location.href = parseResponse.data.url; // Redirect to Google OAuth\r\n  } catch (error) {\r\n    console.error('Failed to get YouTube auth URL:', error);\r\n  }\r\n};\r\n\r\n</script>\r\n","<template>\r\n  <button\r\n  @click=\"linkYoutube\"\r\n    class=\"group flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-red-600 font-semibold border border-red-300 shadow-sm hover:bg-red-600 hover:text-white transition-all duration-300 focus:ring-4 focus:ring-red-300\"\r\n  >\r\n    <Icon\r\n      name=\"mdi:youtube\"\r\n      size=\"25\"\r\n      class=\"transition-transform duration-300 group-hover:scale-110\"\r\n    />\r\n    <span class=\"tracking-wide\">Link YouTube</span>\r\n  </button>\r\n</template>\r\n\r\n<!-- <template>\r\n  <button\r\n   @click=\"linkYoutube\"\r\n    class=\"flex items-center gap-2 px-5 py-2.5 rounded-full bg-red-600 text-white font-medium shadow-sm hover:bg-red-700 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-red-400\"\r\n  >\r\n    <Icon name=\"mdi:youtube\" size=\"20\" />\r\n    Link YouTube\r\n  </button>\r\n</template> -->\r\n\r\n\r\n<script setup lang=\"ts\">\r\nconst linkYoutube = async () => {\r\n  try {\r\n    const res = await fetch('http://localhost:3000/social-accounts/youtube/link');\r\n\r\n    if (!res.ok) {\r\n      throw new Error(`HTTP error! status: ${res.status}`);\r\n    }\r\n\r\n    const parseResponse = await res.json();\r\n\r\n    window.location.href = parseResponse.data.url; // Redirect to Google OAuth\r\n  } catch (error) {\r\n    console.error('Failed to get YouTube auth URL:', error);\r\n  }\r\n};\r\n\r\n</script>\r\n","<template>\r\n  <main class=\"max-w-[1200px] mx-auto min-h-screen p-8\">\r\n    <section class=\"max-w-md rounded-xl border border-gray-200 p-6 shadow-sm\">\r\n      <h1 class=\"mb-1 text-2xl font-semibold\">Admin sign in</h1>\r\n      <p class=\"mb-5 text-sm text-gray-600\">Use the seeded admin account to test the API connection.</p>\r\n\r\n      <form class=\"space-y-4\" @submit.prevent=\"signIn\">\r\n        <label class=\"block\">\r\n          <span class=\"mb-1 block text-sm font-medium\">Email</span>\r\n          <input v-model=\"email\" type=\"email\" required class=\"w-full rounded-md border px-3 py-2\" />\r\n        </label>\r\n        <label class=\"block\">\r\n          <span class=\"mb-1 block text-sm font-medium\">Password</span>\r\n          <input v-model=\"password\" type=\"password\" required class=\"w-full rounded-md border px-3 py-2\" />\r\n        </label>\r\n        <button :disabled=\"pending\" class=\"rounded-md bg-black px-4 py-2 text-white disabled:opacity-50\">\r\n          {{ pending ? 'Connecting...' : 'Sign in' }}\r\n        </button>\r\n      </form>\r\n\r\n      <p v-if=\"status\" class=\"mt-4 text-sm\" :class=\"authenticated ? 'text-green-700' : 'text-red-700'\">\r\n        {{ status }}\r\n      </p>\r\n    </section>\r\n\r\n    <section class=\"mt-8\">\r\n      <div class=\"flex gap-4\">\r\n        <social-google-login />\r\n        <social-facebook-login />\r\n      </div>\r\n      <div class=\"mt-4 flex gap-4\">\r\n        <social-youtube-link />\r\n      </div>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nconst config = useRuntimeConfig();\r\nconst email = ref('');\r\nconst password = ref('');\r\nconst pending = ref(false);\r\nconst authenticated = ref(false);\r\nconst status = ref('');\r\n\r\nconst signIn = async () => {\r\n  pending.value = true;\r\n  authenticated.value = false;\r\n  status.value = '';\r\n\r\n  try {\r\n    await $fetch(`${config.public.apiBase}/auth/sign-in`, {\r\n      method: 'POST',\r\n      body: { email: email.value, password: password.value },\r\n    });\r\n    authenticated.value = true;\r\n    status.value = 'Connected to the API and signed in successfully.';\r\n  } catch {\r\n    status.value = 'Sign-in failed. Check the credentials and API status.';\r\n  } finally {\r\n    pending.value = false;\r\n  }\r\n};\r\n</script>\r\n","<template>\r\n  <main class=\"max-w-[1200px] mx-auto min-h-screen p-8\">\r\n    <section class=\"max-w-md rounded-xl border border-gray-200 p-6 shadow-sm\">\r\n      <h1 class=\"mb-1 text-2xl font-semibold\">Admin sign in</h1>\r\n      <p class=\"mb-5 text-sm text-gray-600\">Use the seeded admin account to test the API connection.</p>\r\n\r\n      <form class=\"space-y-4\" @submit.prevent=\"signIn\">\r\n        <label class=\"block\">\r\n          <span class=\"mb-1 block text-sm font-medium\">Email</span>\r\n          <input v-model=\"email\" type=\"email\" required class=\"w-full rounded-md border px-3 py-2\" />\r\n        </label>\r\n        <label class=\"block\">\r\n          <span class=\"mb-1 block text-sm font-medium\">Password</span>\r\n          <input v-model=\"password\" type=\"password\" required class=\"w-full rounded-md border px-3 py-2\" />\r\n        </label>\r\n        <button :disabled=\"pending\" class=\"rounded-md bg-black px-4 py-2 text-white disabled:opacity-50\">\r\n          {{ pending ? 'Connecting...' : 'Sign in' }}\r\n        </button>\r\n      </form>\r\n\r\n      <p v-if=\"status\" class=\"mt-4 text-sm\" :class=\"authenticated ? 'text-green-700' : 'text-red-700'\">\r\n        {{ status }}\r\n      </p>\r\n    </section>\r\n\r\n    <section class=\"mt-8\">\r\n      <div class=\"flex gap-4\">\r\n        <social-google-login />\r\n        <social-facebook-login />\r\n      </div>\r\n      <div class=\"mt-4 flex gap-4\">\r\n        <social-youtube-link />\r\n      </div>\r\n    </section>\r\n  </main>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nconst config = useRuntimeConfig();\r\nconst email = ref('');\r\nconst password = ref('');\r\nconst pending = ref(false);\r\nconst authenticated = ref(false);\r\nconst status = ref('');\r\n\r\nconst signIn = async () => {\r\n  pending.value = true;\r\n  authenticated.value = false;\r\n  status.value = '';\r\n\r\n  try {\r\n    await $fetch(`${config.public.apiBase}/auth/sign-in`, {\r\n      method: 'POST',\r\n      body: { email: email.value, password: password.value },\r\n    });\r\n    authenticated.value = true;\r\n    status.value = 'Connected to the API and signed in successfully.';\r\n  } catch {\r\n    status.value = 'Sign-in failed. Check the credentials and API status.';\r\n  } finally {\r\n    pending.value = false;\r\n  }\r\n};\r\n</script>\r\n"],"version":3}