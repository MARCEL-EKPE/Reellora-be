{
  "name": "reellora",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@reellora/api",
    "build:web": "npm run build --workspace=@reellora/web",
    "dev:api": "npm run start:dev --workspace=@reellora/api",
    "dev:web": "npm run dev --workspace=@reellora/web",
    "start:api": "npm run start:prod --workspace=@reellora/api",
    "test": "npm run test --workspace=@reellora/api",
    "test:e2e": "npm run test:e2e --workspace=@reellora/api",
    "lint": "npm run lint --workspaces --if-present"
  }
}
